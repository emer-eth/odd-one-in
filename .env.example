NEAR_ACCOUNT_ID=your-account.testnet
NEAR_PRIVATE_KEY=ed25519:...

# House players (scripts/house.ts), for running them on a host. Locally they read .keys/seed.json.
# CONTRACT_ID=ooi.your-account.testnet
# HOUSE_KEYS=[{"accountId":"seed-0.your-account.testnet","secretKey":"ed25519:..."}]
# HOUSE_SECRET=   any long random string: house salts are derived from it
# HOUSE_COUNT=8   use only the first N accounts

# Guest accounts (scripts/guest.ts), served by the same process as the house players when GUEST_FUNDER is set.
# GUEST_FUNDER={"accountId":"your-guest-funder.testnet","secretKey":"ed25519:..."}   pays 0.5 test NEAR per guest
# GUEST_DAILY=40    GUEST_PER_IP=3    GUEST_GRANT=0.5
# GUEST_ORIGINS=https://your-site.example,http://localhost:5173
